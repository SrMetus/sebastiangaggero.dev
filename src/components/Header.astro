---
import LanguageSelector from './LanguageSelector.astro';
import ThemeToggle from './ThemeToggle.astro';
import { routes, cvPaths, type Locale, type Page } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
const content = ui[locale];
const home = routes.home[locale];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home}>
      Sebastian Gaggero
    </a>
    <div class="header-utilities">
      <a class="cv-link" href={cvPaths[locale]} download aria-label={content.downloadCV}>
        <span class="cv-label-short" aria-hidden="true">
          CV
        </span>
        <span class="cv-label-full" aria-hidden="true">
          {content.downloadCV}
        </span>
      </a>
      <LanguageSelector locale={locale} page={page} />
      <ThemeToggle locale={locale} />
    </div>
    <nav aria-label={content.primaryLabel}>
      <ul role="list">
        <li>
          <a href={`${home}#work`}>{content.work}</a>
        </li>
        <li>
          <a href={`${home}#services`}>{content.services}</a>
        </li>
        <li>
          <a href={`${home}#about`}>{content.about}</a>
        </li>
        <li>
          <a href={`${home}#contact`}>{content.contact}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    margin-block-end: var(--space-8);
    border-block-end: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-1);
    row-gap: var(--space-1);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-text);
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  nav {
    grid-column: 1 / -1;
    grid-row: 3;
    max-inline-size: 100%;
  }

  .header-utilities {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
  }

  .header-utilities :global(.language-selector a) {
    min-inline-size: 2.75rem;
  }

  .header-utilities :global(.theme-toggle) {
    inline-size: 2.75rem;
  }

  .cv-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    color: var(--color-text);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-regular);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  .cv-link:hover {
    color: var(--color-primary);
  }

  .cv-label-full {
    display: none;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    inline-size: 100%;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-text);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-regular);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  ul:lang(es) {
    column-gap: var(--space-3);
  }

  /* The brand and utilities share a row only once there is room for both. */
  @media (min-width: 320px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0;
    }

    .header-utilities {
      grid-column: 2;
      grid-row: 1;
      gap: 0;
    }

    .cv-link,
    .header-utilities :global(.language-selector a) {
      min-inline-size: 1.5rem;
    }

    .header-utilities :global(.theme-toggle) {
      inline-size: 1.5rem;
    }

    nav {
      grid-row: 2;
    }

    ul {
      display: flex;
      flex-wrap: wrap;
    }

    nav a {
      inline-size: auto;
    }
  }

  @media (min-width: 48rem) {
    .cv-label-short {
      display: none;
    }

    .cv-label-full {
      display: inline;
    }

    .header-utilities {
      gap: var(--space-3);
    }

    .header-utilities :global(.language-selector a) {
      min-inline-size: 2.75rem;
    }

    .header-utilities :global(.theme-toggle) {
      inline-size: 2rem;
    }

    .header-inner {
      row-gap: var(--space-1);
      column-gap: var(--space-6);
      padding-block: var(--space-6);
    }

    ul,
    ul:lang(es) {
      column-gap: var(--space-6);
    }

    nav a {
      font-size: var(--font-size-body);
    }
  }

  @media (min-width: 64rem) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
    }

    nav {
      grid-column: 2;
      grid-row: 1;
    }

    .header-utilities {
      grid-column: 3;
    }
  }

  /* Explicit placement keeps the ultra-narrow structure independent of auto-placement. */
  @media (max-width: 319px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }

    .header-inner > .brand {
      grid-area: 1 / 1 / 2 / -1;
    }

    .header-inner > .header-utilities {
      grid-area: 2 / 1 / 3 / -1;
      flex-wrap: nowrap;
    }

    .header-inner > nav {
      grid-area: 3 / 1 / 4 / -1;
    }

    .header-inner > nav > ul {
      display: grid;
      grid-template-columns: max-content max-content;
      justify-content: start;
      gap: 0 var(--space-3);
    }
  }
</style>
