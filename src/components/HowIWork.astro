---
import type { HomeContent } from '../i18n/home';
interface Props {
  content: HomeContent['howIWork'];
}
const { content } = Astro.props;
---

<section class="how-i-work" aria-labelledby="how-i-work-heading">
  <h2 id="how-i-work-heading">06 / {content.label}</h2>

  <ol class="process-index" role="list">
    <li>
      <h3>{content.understandTitle}</h3>
      <p>{content.understand}</p>
    </li>
    <li>
      <h3>{content.scopeTitle}</h3>
      <p>{content.scope}</p>
    </li>
    <li>
      <h3>{content.buildTitle}</h3>
      <p>{content.build}</p>
    </li>
    <li>
      <h3>{content.verifyTitle}</h3>
      <p>{content.verify}</p>
    </li>
    <li>
      <h3>{content.deliverTitle}</h3>
      <p>{content.deliver}</p>
    </li>
  </ol>
</section>

<style>
  .how-i-work {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-16);
    border-block-start: 1px solid var(--color-border);
  }

  h2,
  h3,
  p,
  ol {
    margin: 0;
  }

  h2 {
    color: var(--color-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-body);
    letter-spacing: 0.04em;
  }

  .process-index {
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }

  li:first-child {
    padding-block-start: 0;
  }

  li:last-child {
    padding-block-end: 0;
  }

  li + li {
    border-block-start: 1px solid var(--color-border);
  }

  h3 {
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-body);
  }

  p {
    max-inline-size: 55ch;
  }

  @media (min-width: 48rem) {
    li {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      column-gap: var(--space-8);
      align-items: start;
    }
  }
</style>
