---
import type { HomeContent } from '../i18n/home';
interface Props {
  content: HomeContent['services'];
}
const { content } = Astro.props;
---

<section id="services" class="services" aria-labelledby="services-heading">
  <header class="services-introduction">
    <h2 id="services-heading">03 / {content.label}</h2>
    <p>{content.introduction}</p>
  </header>

  <div class="service-row">
    <h3>{content.backendTitle}</h3>
    <dl>
      <div>
        <dt>{content.needLabel}</dt>
        <dd>{content.backendNeed}</dd>
      </div>
      <div>
        <dt>{content.solutionLabel}</dt>
        <dd>{content.backendSolution}</dd>
      </div>
    </dl>
  </div>

  <div class="service-row">
    <h3>{content.automationTitle}</h3>
    <dl>
      <div>
        <dt>{content.needLabel}</dt>
        <dd>{content.automationNeed}</dd>
      </div>
      <div>
        <dt>{content.solutionLabel}</dt>
        <dd>{content.automationSolution}</dd>
      </div>
    </dl>
  </div>

  <div class="service-row">
    <h3>{content.integrationsTitle}</h3>
    <dl>
      <div>
        <dt>{content.needLabel}</dt>
        <dd>{content.integrationsNeed}</dd>
      </div>
      <div>
        <dt>{content.solutionLabel}</dt>
        <dd>{content.integrationsSolution}</dd>
      </div>
    </dl>
  </div>

  <div class="service-row">
    <h3>{content.toolsTitle}</h3>
    <dl>
      <div>
        <dt>{content.needLabel}</dt>
        <dd>{content.toolsNeed}</dd>
      </div>
      <div>
        <dt>{content.solutionLabel}</dt>
        <dd>{content.toolsSolution}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-12) var(--space-16);
    border-block-start: 1px solid var(--color-border);
  }

  .services-introduction,
  .service-row,
  dl {
    display: grid;
    gap: var(--space-4);
  }

  .services-introduction {
    margin-block-end: var(--space-6);
  }

  h2,
  dt {
    color: var(--color-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-body);
    letter-spacing: 0.04em;
  }

  h2,
  h3,
  p,
  dl,
  dd {
    margin: 0;
  }

  .services-introduction p {
    max-inline-size: 60ch;
    font-size: var(--font-size-body-large);
  }

  .service-row {
    padding-block: var(--space-6);
  }

  .service-row:last-child {
    padding-block-end: 0;
  }

  .service-row + .service-row {
    border-block-start: 1px solid var(--color-border);
  }

  h3 {
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-body);
  }

  dt {
    margin-block-end: var(--space-1);
  }

  dd {
    max-inline-size: 55ch;
  }

  @media (min-width: 48rem) {
    .services-introduction,
    .service-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: var(--space-12);
      align-items: start;
    }
  }

  @media (min-width: 64rem) {
    .services-introduction,
    .service-row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }

    dl {
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
      column-gap: var(--space-12);
    }
  }
</style>
