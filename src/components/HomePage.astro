---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import FeaturedJobRadar from './FeaturedJobRadar.astro';
import SelectedWork from './SelectedWork.astro';
import Services from './Services.astro';
import Capabilities from './Capabilities.astro';
import About from './About.astro';
import HowIWork from './HowIWork.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { home } from '../i18n/home';
import { metadata } from '../i18n/metadata';
import { routes, type Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const content = home[locale];
---

<BaseLayout metadata={metadata.home[locale]} locale={locale} page="home">
  <main id="main-content" class="container" tabindex="-1">
    <Hero content={content.hero} />
    <FeaturedJobRadar content={content.featuredJobRadar} caseStudyHref={routes.jobRadar[locale]} />
    <SelectedWork content={content.selectedWork} />
    <Services content={content.services} />
    <Capabilities content={content.capabilities} />
    <About content={content.about} />
    <HowIWork content={content.howIWork} />
    <Contact content={content.contact} />
  </main>
  <Footer />
</BaseLayout>
