---
import type { HomeContent } from '../i18n/home';
interface Props {
  content: HomeContent['featuredJobRadar'];
  caseStudyHref: string;
}
const { content, caseStudyHref } = Astro.props;
---

<section id="work" class="featured-system" aria-labelledby="job-radar-title">
  <header class="system-introduction">
    <div>
      <p class="section-label">01 / {content.label}</p>
      <h2 id="job-radar-title">Job Radar</h2>
    </div>
    <div class="system-summary">
      <p class="system-problem">{content.problem}</p>
      <p>{content.summary}</p>
    </div>
  </header>

  <div class="system-explanation">
    <figure class="system-overview">
      <figcaption>
        <span class="section-label">{content.overviewLabel}</span>
        <span class="overview-caption">{content.overviewCaption}</span>
      </figcaption>
      <p class="system-input">{content.input}</p>
      <dl class="system-stages">
        <div class="system-stage">
          <dt>{content.prepare}</dt>
          <dd>{content.ingestion}</dd>
          <dd>{content.normalization}</dd>
          <dd>{content.deduplication}</dd>
        </div>
        <div class="system-stage">
          <dt>{content.persist}</dt>
          <dd>PostgreSQL</dd>
        </div>
        <div class="system-stage">
          <dt>{content.serve}</dt>
          <dd>REST API</dd>
          <dd>{content.filtering}</dd>
          <dd>{content.pagination}</dd>
          <dd>{content.scoring}</dd>
          <dd>frontend</dd>
        </div>
      </dl>
    </figure>

    <dl class="system-notes">
      <div>
        <dt>{content.identityLabel}</dt>
        <dd>{content.identity}</dd>
      </div>
      <div>
        <dt>{content.scoringLabel}</dt>
        <dd>{content.scoringNote}</dd>
      </div>
      <div>
        <dt>{content.evidenceLabel}</dt>
        <dd>{content.evidence}</dd>
      </div>
    </dl>
  </div>

  <footer class="system-footer">
    <dl class="system-metadata">
      <div>
        <dt>{content.applicationLabel}</dt>
        <dd>Python 3.12 · FastAPI</dd>
      </div>
      <div>
        <dt>{content.dataLabel}</dt>
        <dd>PostgreSQL · SQLAlchemy · Alembic</dd>
      </div>
      <div>
        <dt>{content.deliveryLabel}</dt>
        <dd>Docker</dd>
      </div>
    </dl>
    <div class="system-links">
      <a href={caseStudyHref}>{content.caseStudyLabel}</a>
      <a
        class="live-link"
        href="https://job-radar-bonw.onrender.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        {content.liveLabel}
      </a>
    </div>
  </footer>
</section>

<style>
  .featured-system {
    padding-block: var(--space-12) var(--space-16);
    border-block-start: 1px solid var(--color-border);
  }

  .system-introduction,
  .system-explanation {
    display: grid;
    gap: var(--space-8);
  }

  .section-label,
  .system-notes dt,
  .system-metadata dt {
    color: var(--color-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
  }

  .section-label {
    display: block;
    margin-block-end: var(--space-3);
  }

  h2 {
    margin: 0;
    letter-spacing: -0.025em;
  }

  .system-summary {
    max-inline-size: 60ch;
  }

  .system-summary p:last-child {
    margin: 0;
  }

  .system-problem {
    font-size: var(--font-size-body-large);
    margin-block-end: var(--space-6);
  }

  .system-explanation {
    margin-block: var(--space-8) var(--space-6);
  }

  figure,
  dl,
  dd {
    margin: 0;
  }

  .overview-caption {
    display: block;
    font-size: var(--font-size-small);
  }

  .system-input {
    margin-block: var(--space-6) var(--space-4);
    font-weight: var(--font-weight-semibold);
  }

  .system-stages {
    display: grid;
    gap: var(--space-8);
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--color-border);
  }

  .system-stage dt {
    margin-block-end: var(--space-1);
    color: var(--color-primary);
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-semibold);
  }

  .system-stage dd + dd {
    margin-block-start: var(--space-1);
  }

  .system-notes {
    display: grid;
    align-content: start;
    gap: var(--space-6);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  .system-notes dt,
  .system-metadata dt {
    margin-block-end: var(--space-1);
  }

  .system-notes dd {
    max-inline-size: 40ch;
  }

  .system-footer {
    display: grid;
    gap: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }

  .system-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-8);
  }

  .system-footer a {
    justify-self: start;
    display: inline-flex;
    align-items: flex-start;
    min-block-size: 3rem;
    font-weight: var(--font-weight-semibold);
  }

  .system-links {
    display: grid;
    align-content: start;
    min-inline-size: 0;
    gap: var(--space-1);
  }

  .system-links .live-link {
    font-weight: var(--font-weight-regular);
  }

  @media (min-width: 48rem) {
    .featured-system {
      padding-block: var(--space-16);
    }

    .system-introduction {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-12);
    }

    .system-explanation {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-12);
      margin-block: var(--space-12) var(--space-8);
    }

    .system-notes {
      padding-block-start: 0;
      padding-inline-start: var(--space-6);
      border-block-start: 0;
      border-inline-start: 1px solid var(--color-border);
    }
  }

  @media (min-width: 64rem) {
    .system-explanation {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: var(--space-16);
    }

    .system-stages {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--space-6);
      padding-inline-start: 0;
      padding-block-start: var(--space-4);
      border-inline-start: 0;
      border-block-start: 1px solid var(--color-border);
    }

    .system-footer {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-6);
    }

    .system-metadata {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 0.55fr);
      gap: var(--space-4);
    }
  }
</style>
