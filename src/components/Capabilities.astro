---
import type { HomeContent } from '../i18n/home';
interface Props {
  content: HomeContent['capabilities'];
}
const { content } = Astro.props;
---

<section class="capabilities" aria-labelledby="capabilities-heading">
  <header class="capabilities-introduction">
    <h2 id="capabilities-heading">04 / {content.label}</h2>
    <p>{content.introduction}</p>
  </header>

  <dl class="capability-index">
    <div class="capability-row">
      <dt>Backend</dt>
      <dd>
        <p>Python · FastAPI · REST APIs</p>
        <p>PostgreSQL · SQLAlchemy · Alembic</p>
      </dd>
    </div>
    <div class="capability-row">
      <dt>{content.automationLabel}</dt>
      <dd>
        <p>{content.automationTools}</p>
        <p>{content.automationWork}</p>
      </dd>
    </div>
    <div class="capability-row">
      <dt>{content.workflowLabel}</dt>
      <dd>
        <p>Git · GitHub · Linux · Docker</p>
        <p>pytest · GitHub Actions</p>
      </dd>
    </div>
    <div class="capability-row">
      <dt>{content.integrationsLabel}</dt>
      <dd>
        <p>{content.integrationTools}</p>
        <p>{content.integrationWork}</p>
      </dd>
    </div>
  </dl>
</section>

<style>
  .capabilities {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-16);
    border-block-start: 1px solid var(--color-border);
  }

  h2,
  p,
  dl,
  dd {
    margin: 0;
  }

  h2 {
    margin-block-end: var(--space-4);
    color: var(--color-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-body);
    letter-spacing: 0.04em;
  }

  .capabilities-introduction p {
    max-inline-size: 60ch;
    font-size: var(--font-size-body-large);
  }

  .capability-row {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }

  .capability-row:first-child {
    padding-block-start: 0;
  }

  .capability-row:last-child {
    padding-block-end: 0;
  }

  .capability-row + .capability-row {
    border-block-start: 1px solid var(--color-border);
  }

  dt {
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-body);
  }

  dd p + p {
    margin-block-start: var(--space-1);
  }

  @media (min-width: 48rem) {
    .capability-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: var(--space-8);
      align-items: start;
    }
  }

  @media (min-width: 64rem) {
    .capabilities {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      column-gap: var(--space-12);
      align-items: start;
    }
  }
</style>
